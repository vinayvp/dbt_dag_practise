# ==============================================================================
# Environment Configuration for Local Astro / Airflow Development
# Copy this file to .env and replace the placeholder values.
# ==============================================================================

# Airflow Connection for Snowflake (JSON format handles special characters cleanly)
AIRFLOW_CONN_SNOWFLAKE_CONN='{"conn_type": "snowflake", "login": "YOUR_USERNAME", "password": "YOUR_PASSWORD", "schema": "dbt_schema", "extra": {"account": "YOUR_ACCOUNT_IDENTIFIER", "warehouse": "dbt_wh", "database": "dbt_db", "role": "ACCOUNTADMIN"}}'
